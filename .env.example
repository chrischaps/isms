# Copy to .env (git-ignored). Every variable the server reads, with its dev default.
# Database (deploy/docker-compose.dev.yml). sqlx::test derives per-test databases from this URL,
# so the role must be allowed to CREATE DATABASE (the dev container's superuser is).
DATABASE_URL=postgres://isms:isms@localhost:5433/isms
# Host port for the dev container (CI uses a service on 5432 instead).
ISMS_DB_PORT=5433
# HTTP bind address for `isms-server serve` (S1.3).
ISMS_BIND=127.0.0.1:8080
# Default tick length for societies seeded in dev (seconds; 0 = as fast as possible).
ISMS_TICK_SECONDS=10
# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,isms_server=debug
# Operators (comma-separated account emails) may use the /admin routes: pause, step, resume, end an epoch.
ISMS_OPERATORS=
# Magic-link mail sender: stdout (dev, prints the link), file (prints and appends
# `email<TAB>url` to ISMS_MAIL_FILE; scripts/dev/Get-IsmsMagicLink.ps1 reads it), or smtp (S1.14).
ISMS_MAIL_SENDER=stdout
#ISMS_MAIL_FILE=%LOCALAPPDATA%\isms\mail-isms.log
# Only `make agents` with an LLM brain needs this (S1.16); `make e2e-agents` does not.
ANTHROPIC_API_KEY=
# Only `make agents BRAIN=jev` needs this (SJ.1): TypeSafe's Jev through OpenRouter's Decisions API.
OPENROUTER_API_KEY=
# The side port the synthetic cohort's throwaway server listens on.
AGENTS_PORT=18090
